{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-cdup).codex/hooks/format.mjs\"",
            "timeout": 30,
            "statusMessage": "Prettier 포맷 적용 중"
          }
        ]
      }
    ]
  }
}
